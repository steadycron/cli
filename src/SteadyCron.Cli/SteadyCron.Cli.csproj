<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SteadyCron.Cli</RootNamespace>
    <AssemblyName>steadycron</AssemblyName>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- ── Pack as a .NET global tool ──────────────────────────────────────────── -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>steadycron</ToolCommandName>
    <PackageId>steadycron</PackageId>
    <Title>SteadyCron CLI</Title>
    <Description>Infrastructure-as-code CLI for SteadyCron — declare your scheduled HTTP jobs and heartbeat monitors in a YAML manifest and reconcile them with `steadycron sync`, or manage jobs imperatively. Authenticates with a SteadyCron API key.</Description>
    <PackageTags>cron;scheduler;monitoring;heartbeat;cli;dotnet-tool;steadycron;infrastructure-as-code;devops</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See the changelog: https://github.com/steadycron/cli/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Default version for local builds; CI overrides via -p:Version=… from the git tag. -->
    <Version Condition="'$(Version)' == ''">1.10.0</Version>
  </PropertyGroup>

  <!-- ── Optional package icon (auto-included once icon.png is added at the repo root) ── -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/../../icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- ── Reproducible build + Source Link (source-step into the package) ──────── -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- ── Self-contained single-file publish (release binaries only; needs a RID) ──
       Spectre.Console.Cli resolves command types via reflection, so we ship a
       trim-free self-contained single-file binary rather than NativeAOT. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SteadyCron.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files referenced by package metadata must be packed into the nupkg root. -->
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../icon.png" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildProjectDirectory)/../../icon.png')" />
  </ItemGroup>

</Project>
